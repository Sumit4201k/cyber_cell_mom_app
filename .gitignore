# ------------------------------------------------------------------------------
# 1. Dependencies
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
package-lock.json.bak

# ------------------------------------------------------------------------------
# 2. Environment Variables & Secrets (NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.pem
*.key
*.cert
*.crt

# ------------------------------------------------------------------------------
# 3. Python Virtual Environments, Caches & Model Cache
# ------------------------------------------------------------------------------
venv/
.venv/
env/
.env/
python-service/venv/
python-service/python_env/
**/python_env/
**/.venv/
**/.env/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.ipynb_checkpoints/

# Hugging Face / Whisper offline cached models
.cache/
**/.cache/
huggingface/
.huggingface/
hf_cache/
models/
whisper_models/
*.bin
*.onnx
*.safetensors

# ------------------------------------------------------------------------------
# 4. Logs & Diagnostic Traces
# ------------------------------------------------------------------------------
*.log
*.log.*
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
backend/data/*.log
test_results.json
*.trace

# ------------------------------------------------------------------------------
# 5. Production Builds & Compiled Outputs
# ------------------------------------------------------------------------------
dist/
build/
out/
frontend/dist/
frontend/build/
.vercel/
.next/

# ------------------------------------------------------------------------------
# 6. Audio Storage, Uploads & Temporary Scratch Files (Preserve Storage Directories)
# ------------------------------------------------------------------------------
**/data/temp_*
backend/data/temp_*
python-service/data/temp_*
temp/
**/temp/
tmp/
**/tmp/

# Preserve .gitkeep and storage directories
!storage/
!storage/**
!backend/storage/
!backend/storage/**
!data/
!data/**
!python-service/data/
!python-service/data/**
!backend/data/
!backend/data/*.json
!**/.gitkeep

# Ignore dynamic audio uploads but keep samples/ and .gitkeep
storage/audio/*.mp3
storage/audio/*.wav
storage/audio/*.m4a
storage/audio/*.webm
backend/storage/audio/*.mp3
backend/storage/audio/*.wav
backend/storage/audio/*.m4a
backend/storage/audio/*.webm
!storage/audio/.gitkeep
!backend/storage/audio/.gitkeep
!samples/*.wav
!samples/*.mp3
!samples/*.m4a
!samples/*.aac
!samples/*.flac
!samples/*.ogg

